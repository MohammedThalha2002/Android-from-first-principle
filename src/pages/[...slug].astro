---
import { getCollection, render } from 'astro:content';
import Post from '../layouts/Post.astro';
import Callout from '../components/Callout.astro';
import Diagram from '../components/Diagram.astro';
import CodeTabs from '../components/CodeTabs.astro';
import Snippet from '../components/Snippet.astro';
import ApiLevel from '../components/ApiLevel.astro';
import LabCard from '../components/LabCard.astro';

/**
 * Components are pre-registered here so post files stay plain content with
 * no import block (CONTRIBUTING.md). Adding a component to a post means adding
 * it to this map, once, rather than to every MDX file that uses it.
 */
const components = { Callout, Diagram, CodeTabs, Snippet, ApiLevel, LabCard };

export async function getStaticPaths() {
  const all = (await getCollection('posts')).filter((post) => !post.data.draft);

  // A post id is "<group>/<slug>" for a grouped post, or a bare "<slug>" for a
  // standalone one with no group folder.
  return all.map((post) => ({ params: { slug: post.id }, props: { post, posts: all } }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
---

<Post post={post} posts={posts} headings={headings} Content={Content} components={components} />
