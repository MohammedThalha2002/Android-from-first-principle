---
/**
 * A CSS-only tab set for the one axis that earns tabs in this series:
 * Kotlin/Java, or Compose/Views. Never both axes in one block.
 *
 *   <CodeTabs labels={['Kotlin', 'Java']}>
 *     ```kotlin … ```
 *     ```java … ```
 *   </CodeTabs>
 *
 * Radio inputs plus labels, no client JavaScript: the tabs work before
 * hydration and on a page that ships no islands at all. Every panel stays in
 * the DOM, so Pagefind indexes all versions rather than only the visible one.
 *
 * The rule from the curriculum, unchanged: a snippet earns a second tab only
 * when the second version TEACHES something.
 */
interface Props {
  labels?: string[];
}

const labels = Astro.props.labels ?? ['Kotlin', 'Java'];
// Unique per instance so two tab sets on one page do not drive each other.
const name = `tabs-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="code-tabs">
  <div class="tab-strip" role="tablist">
    {labels.map((label, index) => (
      <>
        <input
          class="tab-input"
          type="radio"
          name={name}
          id={`${name}-${index}`}
          checked={index === 0}
          data-index={index}
        />
        <label class="tab-label" for={`${name}-${index}`}>{label}</label>
      </>
    ))}
  </div>
  <div class="tab-panels"><slot /></div>
</div>

<style>
  .code-tabs {
    background: var(--code-bg);
    border-radius: var(--radius-lg);
    margin: var(--space-5) 0;
    max-width: var(--measure-wide);
    overflow: hidden;
  }

  .tab-strip {
    background: var(--code-surface);
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: var(--space-2) var(--space-3);
  }

  .tab-input {
    height: 1px;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    width: 1px;
  }

  .tab-label {
    border-radius: var(--radius-pill);
    color: var(--code-ink-2);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: 1;
    padding: 0.4rem 0.7rem;
  }
  .tab-label:hover { color: var(--code-ink); }

  /* Each radio sits immediately before its own label, so :checked + label
     styles the active tab without knowing how many tabs there are. */
  .tab-input:checked + .tab-label { background: var(--code-line); color: var(--code-ink); }
  .tab-input:focus-visible + .tab-label { box-shadow: 0 0 0 2px var(--accent); }

  /* Panels are hidden by default; the checked radio reveals the matching
     child. Supports up to six versions, which is five more than any snippet
     in this series should need. */
  .tab-panels > :global(*) { display: none; }
  .tab-panels > :global(:first-child) { display: block; }
  .tab-strip:has(.tab-input:checked) ~ .tab-panels > :global(*) { display: none; }
  .tab-strip:has(.tab-input[data-index='0']:checked) ~ .tab-panels > :global(:nth-child(1)),
  .tab-strip:has(.tab-input[data-index='1']:checked) ~ .tab-panels > :global(:nth-child(2)),
  .tab-strip:has(.tab-input[data-index='2']:checked) ~ .tab-panels > :global(:nth-child(3)),
  .tab-strip:has(.tab-input[data-index='3']:checked) ~ .tab-panels > :global(:nth-child(4)),
  .tab-strip:has(.tab-input[data-index='4']:checked) ~ .tab-panels > :global(:nth-child(5)),
  .tab-strip:has(.tab-input[data-index='5']:checked) ~ .tab-panels > :global(:nth-child(6)) { display: block; }

  /* The panel supplies the scroll box; the code block inside it is flush. */
  .tab-panels :global(pre) {
    background: transparent !important;
    border-radius: 0;
    margin: 0;
    max-width: none;
  }
</style>
