---
/**
 * The chapter's lab: the smallest app that makes the mechanism visible.
 *
 * Rendered from the curriculum's own "Lab" bullet, with the Gradle path of
 * the module that holds it. It is deliberately NOT an h2 — h2s are the
 * trackable sections, and the lab has its own "lab done" toggle in the
 * progress card, so a heading here would count it twice.
 */
interface Props {
  /** Gradle path, e.g. ":ch04-lifecycle-state". */
  module?: string;
  title?: string;
}

const { module, title = 'Lab' } = Astro.props;
---

<aside class="lab card">
  <div class="card-head" data-tint="blue">
    <span class="lab-title">
      <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M8 2.5v5.2L3.4 15A2 2 0 0 0 5.1 18h9.8a2 2 0 0 0 1.7-3L12 7.7V2.5" /><path d="M7 2.5h6M6.6 12h6.8" />
      </svg>
      {title}
    </span>
    {module && <code class="lab-module">{module}</code>}
  </div>
  <div class="card-body lab-body"><slot /></div>
</aside>

<style>
  .lab { margin: var(--space-5) 0; max-width: var(--measure); }
  .lab-title { align-items: center; display: inline-flex; gap: var(--space-2); }
  .lab-module {
    background: color-mix(in srgb, currentColor 12%, transparent);
    border: 0;
    border-radius: var(--radius-sm);
    color: inherit;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 0.15rem 0.4rem;
  }
  .lab-body {
    color: var(--ink-2);
    font-size: var(--text-base);
    line-height: var(--leading-read);
  }
  .lab-body :global(> * + *) { margin-top: var(--space-3); }
</style>
