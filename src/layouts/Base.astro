---
/**
 * The app shell: a dark chrome bar above a themed canvas.
 *
 * `group` stamps data-group on <html>, which swaps --accent to that
 * group's colour for everything inside. Pages that belong to no group
 * (home) leave it unset and get the platform primary.
 */
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/base.css';
import '../styles/prose.css';
import CodeCopy from '../components/CodeCopy.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import { getGroup } from '../data/groups';

interface Props {
  title: string;
  description?: string;
  group?: string;
  /** Which pill in the top nav is current. */
  nav?: 'home' | 'group';
}

const {
  title,
  description = 'Open-source Android courses, explained one layer below the API.',
  group: groupId,
  nav,
} = Astro.props;

const SITE = 'First Principles';
const pageTitle = title === SITE ? title : `${title} · ${SITE}`;
const activeGroup = groupId ? getGroup(groupId) : undefined;
const current = (key: Props['nav']) => (nav === key ? 'page' : undefined);
---

<!doctype html>
<html lang="en" data-group={groupId}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script is:inline>
      // Theme resolves before first paint. Only an explicit choice is
      // stamped; "system" leaves the attribute off and the media query decides.
      (() => {
        try {
          const theme = localStorage.getItem('theme');
          if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
          else document.documentElement.removeAttribute('data-theme');
        } catch {
          document.documentElement.removeAttribute('data-theme');
        }
      })();
    </script>
  </head>
  <body>
    <div class="app">
      <header class="chrome-bar">
        <a class="brand" href="/">
          <span>{SITE}</span>
        </a>
        <nav class="pill-nav" aria-label="Primary">
          <a href="/" aria-current={current('home')}>Home</a>
          {activeGroup && (
            <a href={`/${activeGroup.id}/`} aria-current={current('group')}>Courses</a>
          )}
        </nav>
        <div class="chrome-actions">
          <ThemeSwitch />
        </div>
      </header>

      <div class="canvas">
        <slot />
      </div>
    </div>
    <CodeCopy />
  </body>
</html>
